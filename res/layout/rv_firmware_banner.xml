<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@android:color/transparent"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:androidprv="http://schemas.android.com/apk/prv/res/android">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="140.0dip"
        android:layout_marginBottom="10.0dip">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="fill_parent"
            app:cardBackgroundColor="@android:color/transparent"
            android:layout_height="150.0dip"
            android:layout_marginStart="16.0dip"
            android:layout_marginEnd="16.0dip"
            app:cardCornerRadius="28.0dip"
            app:cardElevation="0.0dip">
            <com.android.settings.utils.WallpaperView
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:scaleType="centerCrop"
                app:blurred="true" />
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="140.0dip" />
            <LinearLayout
                android:gravity="start|center"
                android:layout_gravity="start|center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0.0dip"
                android:layout_marginStart="20.0dip">
                <TextView
                    android:textSize="28.0sp"
                    android:textColor="@android:color/white"
                    android:gravity="start|center"
                    android:layout_gravity="start|center"
                    android:fadingEdge="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_marginBottom="5.0dip"
                    android:text="RvOS°"
                    android:singleLine="true"
                    android:fontFamily="@font/PangramsansMedium" 
                    android:textStyle="bold" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="?android:textColorPrimaryInverse"
                    android:ellipsize="marquee"
                    android:gravity="start|center"
                    android:layout_gravity="start|center"
                    android:background="@drawable/rv_cardview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1.0dip"
                    android:text="Long Term Support"
                    android:backgroundTint="?android:colorAccent"
                    android:paddingHorizontal="8.0dip"
                    android:paddingVertical="2.0dip"
                    android:fontFamily="@font/PangramsansMedium" 
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:gravity="end|center"
                android:layout_gravity="end|center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0.0dip"
                android:layout_marginStart="100.0dip">
                <androidx.cardview.widget.CardView
                    android:layout_width="150.0dip"
                    android:layout_height="150.0dip"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="49.0dip"
                    app:cardElevation="0.0dip">
                    <ImageView
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_width="120.0dip"
                        android:layout_height="120.0dip"
                        android:src="@drawable/rvos_banner"
                        android:tint="@android:color/white" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</FrameLayout>
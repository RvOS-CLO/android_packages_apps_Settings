<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/container"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="100.0dip"
    android:layout_marginTop="2.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rv_about_phone_header_illustration_container"
        android:layout_width="fill_parent"
        android:layout_height="80.0dip"
        android:layout_marginHorizontal="@dimen/rv_pref_card_horizontal_padding"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="40.0dip"
        app:cardElevation="0.0dip">
        <com.rvos.preferences.rvCardPrefWall
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:elevation="0.0dip" />
        <LinearLayout
            android:background="@color/rv_clock_bg"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:alpha="0.85" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/rv_pref_card_account"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:baselineAligned="false">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <ImageView
                    android:id="@+id/rv_avatar"
                    android:layout_width="64.0dip"
                    android:layout_height="64.0dip"
                    android:layout_marginStart="10.0dip" />
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:padding="16.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <TextView
                        android:textColor="@color/rv_clock_color"
                        android:ellipsize="marquee"
                        android:id="@+id/rv_account_owner"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rv_dashboard_device"
                        android:singleLine="true"
                        android:layout_below="@id/rv_avatar"
                        android:layout_alignStart="@id/rv_avatar"
                        style="@style/rv_text_primary_medium" />
                    <TextView
                        android:textSize="10.0dip"
                        android:textColor="@color/rv_clock_color"
                        android:id="@+id/rv_account_summary"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rv_dashboard_account_summary"
                        android:layout_below="@id/rv_account_owner"
                        android:alpha="0.8"
                        android:layout_alignStart="@id/rv_account_owner"
                        style="@style/rv_text_secondary" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>